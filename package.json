{
  "name": "linux-game-integrity",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p apps/verifier-api/tsconfig.json",
    "test": "npm run build && jest --runInBand",
    "start": "node dist/apps/verifier-api/src/main.js",
    "migrate": "node dist/apps/verifier-api/src/migrate.js",
    "format:check": "prettier --check \"apps/verifier-api/**/*.{ts,js,json}\" \"packages/policy-engine/**/*.ts\" package.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/apps/verifier-api/test/**/*.test.js"
    ]
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
